flowchart LR
    CAM["图像来源<br/>USB 摄像头或兼容载板上的 MIPI-CSI 摄像头"] --> CAP["采集适配层<br/>后端与像素格式以目标环境为准"]
    CAP --> VALID{"帧有效？<br/>非空、尺寸和类型符合约定"}
    VALID -- 否 --> STOP["记录原因并停止或有界重试<br/>不生成控制命令"]
    VALID -- 是 --> NORM["规范化表示<br/>确认通道顺序、尺寸与帧身份"]
    NORM --> PRE["OpenCV 预处理<br/>ROI / resize / 灰度 / 阈值"]
    PRE --> DEC["特征或视觉判断<br/>保留输入帧关联与结果信息"]
    DEC --> OUT{"需要物理反馈？"}
    OUT -- 否 --> STORE["显示、日志或离线分析"]
    OUT -- 是 --> MSG["生成有界且可校验的业务结果"]
    MSG --> MCU{"MCU 侧检查<br/>时效、范围、状态与安全条件"}
    MCU -- 不满足 --> REJECT["拒绝动作并记录状态"]
    MCU -- 满足 --> ACT["执行受控输出<br/>由 MCU 实时逻辑负责"]
